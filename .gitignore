# --- Database Storage ---
# This ignores the local database folders. 
# It keeps your repository lightweight and fast to clone.
local_qdrant_db/

# --- Virtual Environments ---
# Ignores the local Python packages installed in the virtual environment.
.venv/
venv/
ENV/

# --- Python System Caches ---
# Ignores compiled python files.
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Generated Evaluation Results ---
metrics/evaluation_results.json

# --- OS Caches ---
.DS_Store
Thumbs.db

# --- Source Documents ---
# Ignore the contents of the source_docs directory, but keep the directory itself
source_docs/*
!source_docs/.gitkeep

